---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PublicationCard from '../components/PublicationCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site, HOMEPAGE_PUBLICATION_COUNT } from '../data/site';

// Prefer entries flagged `selected: true`. If none are flagged, fall back to
// the most recent, so the homepage is never empty just because the flag was
// forgotten on a new paper.
const all = await getCollection('publications');
const byYear = all.sort((a, b) => b.data.year - a.data.year);
const flagged = byYear.filter((p) => p.data.selected);
const featured = (flagged.length > 0 ? flagged : byYear).slice(0, HOMEPAGE_PUBLICATION_COUNT);

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPost = posts[0];
---

<Base>
  <section class="hero">
    <img class="avatar" src={site.avatar} alt={`Portrait of ${site.name}`} width="120" height="120" />
    <div>
      <h1>{site.displayName}</h1>
      <p class="role">
        {site.role} ·{' '}
        <a href={site.affiliationUrl} rel="noopener">{site.affiliation}</a>
      </p>
      {
        site.interests.length > 0 && (
          <ul class="interests">
            {site.interests.map((interest) => (
              <li>{interest}</li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <section class="bio">
    {site.bio.map((paragraph) => <p>{paragraph}</p>)}
    <SocialLinks />
  </section>

  {
    featured.length > 0 && (
      <section>
        <h2 class="section-heading">Selected work</h2>
        <div class="stack">
          {featured.map((entry) => (
            <PublicationCard entry={entry} />
          ))}
        </div>
        {all.length > featured.length && (
          <a class="more" href="/publications">
            All {all.length} publications →
          </a>
        )}
      </section>
    )
  }

  {
    latestPost && (
      <section>
        <h2 class="section-heading">Latest writing</h2>
        <a class="post-link" href={`/blog/${latestPost.id}`}>
          <span class="post-title">{latestPost.data.title}</span>
          <time datetime={latestPost.data.pubDate.toISOString()}>
            {latestPost.data.pubDate.toLocaleDateString('en-GB', {
              year: 'numeric',
              month: 'short',
            })}
          </time>
        </a>
        {posts.length > 1 && (
          <a class="more" href="/blog">
            All {posts.length} posts →
          </a>
        )}
      </section>
    )
  }
</Base>

<style>
  section + section {
    margin-top: var(--sp-7);
  }

  .hero {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
  }

  .avatar {
    width: 7.5rem;
    height: 7.5rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
    background: var(--bg-subtle);
    flex-shrink: 0;
  }

  .role {
    margin-top: var(--sp-1);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .interests {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    list-style: none;
    padding: 0;
    margin-top: var(--sp-3);
  }

  .interests li {
    padding: 0 var(--sp-2);
    border-radius: var(--radius-sm);
    background: var(--accent-subtle);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 550;
  }

  .bio {
    margin-top: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .more {
    display: inline-block;
    margin-top: var(--sp-4);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
  }

  .post-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
    text-decoration: none;
    color: var(--text);
  }

  .post-link:hover {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .post-title {
    font-weight: 550;
  }

  .post-link time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-faint);
    white-space: nowrap;
  }

  /* Stack the hero vertically on phones — a 120px avatar beside text is too
     tight below ~30rem. */
  @media (max-width: 30rem) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-4);
    }
  }
</style>
