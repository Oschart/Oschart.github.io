---
// Light/dark switch. The initial theme is applied by the blocking script in
// Base.astro before paint; this button only handles subsequent user toggles.
---

<button id="theme-toggle" type="button" aria-label="Toggle dark mode">
  <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<style>
  button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    cursor: pointer;
  }

  button:hover {
    color: var(--text);
    background: var(--bg-subtle);
    border-color: var(--border);
  }

  svg {
    grid-area: 1 / 1;
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  /*
   * Show whichever icon represents the theme you'd switch TO: moon in light
   * mode, sun in dark mode.
   *
   * Keyed on the presence of [data-theme='dark'] only — never on its absence.
   * `:not([data-theme='dark']) .sun` would be wrong: the descendant combinator
   * lets it match via <body>/<header>/<nav>, none of which carry the attribute,
   * so the sun would be hidden in dark mode too.
   *
   * Defaulting to the moon also means a no-JS visitor sees exactly one icon.
   */
  .sun {
    display: none;
  }

  :global([data-theme='dark']) .sun {
    display: block;
  }

  :global([data-theme='dark']) .moon {
    display: none;
  }
</style>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.dataset.theme === 'dark';
    const next = isDark ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>
