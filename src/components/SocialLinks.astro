---
import { site } from '../data/site';

interface Props {
  /** Include a mailto: link for site.email alongside the social profiles. */
  showEmail?: boolean;
}

const { showEmail = true } = Astro.props;

// Icon paths keyed by the `icon` field in site.socials. To add a network, add
// a key here and reference it from site.ts. Unknown keys fall back to `link`.
const icons: Record<string, string> = {
  scholar:
    'M12 3 1 9l11 6 9-4.91V17h2V9M5 13.18v4L12 21l7-3.82v-4L12 17z',
  github:
    'M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z',
  linkedin:
    'M6.94 5a1.94 1.94 0 1 1-3.88 0 1.94 1.94 0 0 1 3.88 0zM3.5 8.5h3.9V21H3.5zM10.3 8.5h3.74v1.71h.05c.52-.94 1.8-1.93 3.7-1.93 3.96 0 4.69 2.5 4.69 5.76V21h-3.9v-5.42c0-1.29-.02-2.96-1.85-2.96-1.85 0-2.13 1.41-2.13 2.87V21h-3.9z',
  x: 'M18.24 2.25h3.31l-7.23 8.26L22.5 21.75h-6.66l-5.22-6.82-5.97 6.82H1.34l7.73-8.84L1.5 2.25h6.83l4.71 6.23zm-1.16 17.52h1.83L7.08 4.13H5.11z',
  bluesky:
    'M12 10.8C10.9 8.66 7.9 4.66 5.12 2.7 2.45.82 1.44 1.14.77 1.44.01 1.79 0 2.94 0 3.62s.37 5.55.61 6.37c.8 2.7 3.66 3.62 6.29 3.33-3.86.57-7.29 1.98-2.79 6.99 4.95 5.1 6.79-1.09 7.73-4.23.94 3.14 2.03 9.11 7.65 4.23 4.22-4.23 1.16-6.42-2.7-6.99 2.63.29 5.49-.63 6.29-3.33.24-.82.61-5.69.61-6.37s-.01-1.83-.77-2.18c-.67-.3-1.68-.62-4.35 1.26C15.79 4.66 12.79 8.66 12 10.8z',
  orcid:
    'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM8.2 6.4a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8zm.75 2.9h-1.5v7.4h1.5zm2.35 0h2.9c2.35 0 3.7 1.6 3.7 3.7 0 2.3-1.65 3.7-3.75 3.7H11.3zm1.5 1.35v4.7h1.3c1.6 0 2.5-.95 2.5-2.35 0-1.35-.8-2.35-2.5-2.35z',
  link: 'M10.6 13.4a4 4 0 0 0 5.66 0l3-3a4 4 0 1 0-5.66-5.66l-1.5 1.5M13.4 10.6a4 4 0 0 0-5.66 0l-3 3a4 4 0 1 0 5.66 5.66l1.5-1.5',
};

const entries = [
  ...site.socials.map((s) => ({ label: s.label, href: s.href, icon: s.icon as string })),
  ...(showEmail ? [{ label: 'Email', href: `mailto:${site.email}`, icon: 'email' }] : []),
];
---

<ul>
  {
    entries.map((entry) => (
      <li>
        <a href={entry.href} rel="me noopener" title={entry.label} aria-label={entry.label}>
          {entry.icon === 'email' ? (
            <svg viewBox="0 0 24 24" aria-hidden="true" class="stroked">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m2 7 10 6 10-6" />
            </svg>
          ) : (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={icons[entry.icon] ?? icons.link} />
            </svg>
          )}
          <span>{entry.label}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    list-style: none;
    padding: 0;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-1) var(--sp-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--bg-raised);
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: currentColor;
    flex-shrink: 0;
  }

  /* The email envelope is drawn with strokes, not a filled path. */
  svg.stroked {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
