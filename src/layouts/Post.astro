---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = entry.data;

const fmt = (date: Date) =>
  date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={title} description={description} ogType="article">
  <article>
    <header>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        {updatedDate && <span>· updated {fmt(updatedDate)}</span>}
      </p>
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>

    <a class="back" href="/blog">← All posts</a>
  </article>
</Base>

<style>
  header {
    padding-bottom: var(--sp-5);
    margin-bottom: var(--sp-5);
    border-bottom: 1px solid var(--border);
  }

  .meta {
    margin-top: var(--sp-2);
    font-size: var(--text-sm);
    color: var(--text-faint);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    list-style: none;
    padding: 0;
    margin-top: var(--sp-3);
  }

  .tags li {
    padding: 0 var(--sp-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* Rhythm for markdown-rendered content. Scoped so it cannot leak into
     component markup elsewhere on the page. */
  .prose :global(h2) {
    margin-top: var(--sp-6);
    margin-bottom: var(--sp-3);
  }

  .prose :global(h3) {
    margin-top: var(--sp-5);
    margin-bottom: var(--sp-2);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(pre) {
    margin-bottom: var(--sp-4);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--sp-5);
  }

  .prose :global(li) {
    margin-bottom: var(--sp-1);
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--border-strong);
    padding-left: var(--sp-4);
    margin-bottom: var(--sp-4);
    color: var(--text-muted);
  }

  .prose :global(img) {
    border-radius: var(--radius);
    margin-bottom: var(--sp-4);
  }

  .back {
    display: inline-block;
    margin-top: var(--sp-6);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .back:hover {
    text-decoration: underline;
  }
</style>
